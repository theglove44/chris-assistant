{
  "name": "chris-assistant",
  "version": "0.1.0",
  "description": "Multi-provider personal AI assistant for Telegram and Discord",
  "type": "module",
  "bin": {
    "chris": "bin/chris"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && node scripts/check-esbuild-compat.js",
    "chris": "tsx src/cli/index.ts",
    "setup:calendar-helper": "bash scripts/setup-calendar-helper.sh",
    "setup:reminders-helper": "bash scripts/setup-reminders-helper.sh",
    "test": "vitest run",
    "clawpatch:map": "clawpatch map",
    "clawpatch:review": "clawpatch review --limit 10",
    "clawpatch:report": "clawpatch report",
    "clawpatch:status": "clawpatch status",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/prepare-docs-routes.js && node scripts/check-docs-routes.js",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "npm run docs:build && rsync -avz --delete docs/.vitepress/dist/ ${DOCS_DEPLOY_HOST:?Set DOCS_DEPLOY_HOST}:~/chris-assistant-docs/"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@octokit/rest": "^22.0.1",
    "@openai/codex-sdk": "^0.147.0",
    "commander": "^15.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.30.0",
    "linkedom": "^0.18.12",
    "liquidjs": "^10.28.0",
    "openai": "^6.22.0",
    "playwright": "^1.58.2",
    "pm2": "^7.0.3",
    "twitter-api-v2": "^1.29.0",
    "yaml": "^2.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "clawpatch": "^0.7.0",
    "fast-check": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "ip-address": "10.4.0",
    "pm2": {
      "js-yaml": "4.3.1"
    }
  }
}
