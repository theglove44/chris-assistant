# Telegram bot token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user ID (so only YOU can talk to the bot)
# Send /start to @userinfobot on Telegram to find yours
TELEGRAM_ALLOWED_USER_ID=your_numeric_user_id_here

# GitHub fine-grained personal access token.
# Grant Contents read/write only on the private memory repository.
GITHUB_TOKEN=your_github_pat_here

# GitHub memory repo (format: owner/repo)
GITHUB_MEMORY_REPO=your-username/chris-assistant-memory

# Optional: active model and reasoning effort.
# Use `chris model` for supported shortcuts and provider-specific effort levels.
# AI_MODEL=gpt-5.6-terra
# AI_REASONING_EFFORT=medium

# Optional: DeepSeek personal-assistant provider.
# Keep real keys in .env only; never commit them or paste them into logs/issues.
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_THINKING=enabled

# Optional: Brave Search API key for web search tool
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# Optional: GitHub webhook for PR merge notifications to Discord
# GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# WEBHOOK_PORT=3001

# Optional: proactive journal-gap notices (disabled by default)
# NOTICE_LOOP_ENABLED=true
# NOTICE_LOOP_INTERVAL_MINUTES=60
# NOTICE_QUIET_START_HOUR=22
# NOTICE_QUIET_END_HOUR=8
# NOTICE_JOURNAL_GAP_DAYS=2
